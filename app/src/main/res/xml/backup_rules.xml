<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include Room Database files -->
    <include domain="database" path="smart_audio_tasks_db" />
    <include domain="database" path="smart_audio_tasks_db-wal" />
    <include domain="database" path="smart_audio_tasks_db-shm" />
    <!-- Include internal auto backup snapshots -->
    <include domain="file" path="auto_backups" />
    <include domain="file" path="db_safety_backups" />
    <!-- Include SharedPreferences (Theme, settings, audio progress) -->
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="gemini_secure_prefs.xml" />
</full-backup-content>
